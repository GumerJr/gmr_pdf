# =============================================================================
# Exemplo de variáveis de ambiente - copie para .env e preencha
# =============================================================================

# Caminho do JSON da conta de serviço (absoluto ou relativo à raiz do projeto)
GMR_GOOGLE_SERVICE_ACCOUNT_FILE=config/credentials/service_account.json

# ID da pasta do Google Drive (extraído da URL da pasta)
GMR_GOOGLE_DRIVE_FOLDER_ID=
